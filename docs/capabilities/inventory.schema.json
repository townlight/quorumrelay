{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability research snapshot (not engine implementation acceptance)",
  "type": "object",
  "required": [
    "schema_version",
    "observation_date",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "providers": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "type": "object",
        "required": [
          "id",
          "canonical_id",
          "family_id",
          "aliases",
          "name",
          "baseline_formats",
          "operations",
          "evidence",
          "outbound_mappings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "baseline_formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "object",
            "required": [
              "identify",
              "discover",
              "fetch",
              "parse",
              "native_search",
              "local_search",
              "neutral_export",
              "vendor_file_export",
              "create",
              "update",
              "upload"
            ],
            "additionalProperties": false,
            "properties": {
              "identify": {
                "$ref": "#/$defs/operation"
              },
              "discover": {
                "$ref": "#/$defs/operation"
              },
              "fetch": {
                "$ref": "#/$defs/operation"
              },
              "parse": {
                "$ref": "#/$defs/operation"
              },
              "native_search": {
                "$ref": "#/$defs/operation"
              },
              "local_search": {
                "$ref": "#/$defs/operation"
              },
              "neutral_export": {
                "$ref": "#/$defs/operation"
              },
              "vendor_file_export": {
                "$ref": "#/$defs/operation"
              },
              "create": {
                "$ref": "#/$defs/operation"
              },
              "update": {
                "$ref": "#/$defs/operation"
              },
              "upload": {
                "$ref": "#/$defs/operation"
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "url",
                "observation_date",
                "proof_level"
              ]
            }
          },
          "outbound_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity",
                "operation",
                "endpoint_or_format",
                "field_mappings",
                "evidence_ids",
                "interface_type",
                "implementation_status",
                "acceptance_status"
              ],
              "properties": {
                "interface_type": {
                  "enum": [
                    "documented_automated_api",
                    "unresolved",
                    "gated_sdk_contract_unverified",
                    "manual_ui_documented_machine_contract_unverified",
                    "documented_file_import",
                    "manual_ui_export_only_import_unverified",
                    "manual_ui_or_feature_indexed_only",
                    "other_product_applicability_unverified",
                    "neutral_standard_not_provider_write"
                  ]
                },
                "acceptance_status": {
                  "enum": [
                    "not_run",
                    "mock_passed",
                    "fixture_passed",
                    "live_read_passed",
                    "live_write_passed"
                  ]
                },
                "field_mappings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "normalized",
                      "provider_field",
                      "mapping_level"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "capability_status",
        "implementation_status",
        "acceptance_status",
        "evidence_ids",
        "evidence_level",
        "test_access",
        "restrictions"
      ],
      "properties": {
        "capability_status": {
          "enum": [
            "documented",
            "observed",
            "baseline_source",
            "unverified",
            "unavailable_documented"
          ]
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "not_implemented",
            "baseline_only",
            "blocked_access",
            "pending_shared_engine"
          ]
        },
        "acceptance_status": {
          "enum": [
            "not_run",
            "mock_passed",
            "fixture_passed",
            "live_read_passed",
            "live_write_passed"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_level": {
          "type": "string",
          "minLength": 1
        },
        "test_access": {
          "type": "string",
          "minLength": 1
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
