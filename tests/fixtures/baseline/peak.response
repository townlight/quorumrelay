      /* CollapsiblePanel*/
      .CollapsiblePanel {
        margin: 0px;
        padding: 0px;
      }
      /* Remove outline on a selected CollapsiblePanel */
      div:focus {
        outline: 0;
      }

      .CollapsiblePanelTab {
        font-size:1.4em;
        font-weight:bold;
        margin: 0px;
        padding: 10px 10px 10px 5px;
        cursor: pointer;
        -moz-user-select: none;
        -khtml-user-select: none;
        border-bottom: solid #666 thin;
        color: #000000;
        background: #F1F1F1;
      }

      /* Note: CollapsiblePanelContent must not have padding or causes animation issues*/
      .CollapsiblePanelContent {
        margin: 0;
        padding: 0;
        background-color: #fff;
        height: 250px;
        overflow: auto;
      }

      .CollapsiblePanelTab a {
        color: black;
        text-decoration: none;
      }

      .CollapsiblePanelOpen .CollapsiblePanelTab {
        background: #C5C3C3;
      }

      .CollapsiblePanelTabHover,  .CollapsiblePanelOpen {
        background: #C5C3C3;
      }
      .CollapsiblePanelOpen .CollapsiblePanelTab::before {
        content: " - ";
        display: inline-block;
        width: 20px;
        font-size: 20px;
      }
      .CollapsiblePanelClosed .CollapsiblePanelTab::before {
        content: " + ";
        position: relative;
        bottom: .05em;
        display: inline-block;
        width: 20px;
        font-size: 20px;
      }

      /* Tabs */
      .TabbedPanels {
        margin: 0px;
        padding: 0px;
        float: left;
        clear: none;
        width: 100%; /* IE Hack to force proper layout when preceded by a paragraph. (hasLayout Bug)*/
      }

      .TabbedPanelsTabGroup {
        margin: 0;
        padding: 0;
      }

      .TabbedPanelsTabGroup li:last-child {
        margin-right:0;
      }

      .TabbedPanelsTab {
        position: relative;
        top: 1px;
        float: left;
        padding: 8px 10px;
        margin: 0px 2px 5px 0px !important;
        font: bold 1.0em sans-serif;
        list-style: none;
        border-left: solid 1px #CCC;
        border-bottom: solid 1px #ccc;
        border-top: solid 1px #ccc;
        border-right: solid 1px #ccc;
        -moz-user-select: none;
        -khtml-user-select: none;
        cursor: pointer;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
        color: #000000;
        background-color: #F1F1F1;
      }
      /* Remove outline on a selected TabbedPanlsTab */
      .TabbedPanelsTab:focus {
        outline: 0;
      }

      .TabbedPanelsTabHover {
        background-color: #C5C3C3;
      }

      .TabbedPanelsTabSelected {
        background-color: #C5C3C3;
      }

      .TabbedPanelsTab a {
        color: black;
        text-decoration: none;
      }

      .TabbedPanelsContentGroup {
        clear: both;
        background-color: #fff;
      }

