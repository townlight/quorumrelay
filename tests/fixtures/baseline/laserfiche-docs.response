</ul></div><input name="searchBox" type="text" id="searchBox" aria-label="Search" /><input type="hidden" name="searchLoc" id="searchLoc" /><input type="image" name="searchButton" id="searchButton" class="btn btn-primary TopBarSearchSubmitButton" src="/PublicWeblink/images/search.png" alt="Search" onclick="ShowSearchRunning();WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(&quot;searchButton&quot;, &quot;&quot;, false, &quot;&quot;, &quot;../../../Search.aspx&quot;, false, false))" language="javascript" /><input name="searchFolderID" type="hidden" id="searchFolderID" value="517168" /><script>
            function Browse_SubmitOnEnter(event)
            {
                var e = event || window.event;
                var code = e.charCode || e.keyCode;
                if (code == 13 || code == 10)
                {
                    var searchBttn = $get('searchButton');
                    if(searchBttn) { searchBttn.focus(); searchBttn.click(); }
                    if(e.preventDefault) { e.preventDefault(); }
                    if(e.stopPropagation) { e.stopPropagation(); }
                    if(e.returnValue) { e.returnValue = false; }
                    return false;
                }
            }
            $get('searchBox').onkeydown = Browse_SubmitOnEnter;
            $get('searchBox').onkeypress = Browse_SubmitOnEnter;

            $(document).ready(function () {

                /////////////////////////////////////////////////////////
                // show dropdown when dropdown arrow is selected
                /////////////////////////////////////////////////////////

                function ShowDropDownOnEnterOrSpace(event)
                {
                    var e = event || window.event;
                    var code = e.charCode || e.keyCode;
                    if (code == 13 || code == 10 || code == 32)
                    {
                        return ShowDropDown(event);
                    }
                }
                function ShowDropDown(event)
                {
                    $('#_ctl7').toggleClass('active');
                    $('#SearchLocationDropDown').attr('aria-hidden', 'false');
                    return false;
                }

                // attach handlers to dropdown arrow
                $get('_ctl7').onclick = ShowDropDown;
                $get('_ctl7').onkeydown = ShowDropDownOnEnterOrSpace;
                $get('_ctl7').onkeypress = ShowDropDownOnEnterOrSpace;

                /////////////////////////////////////////////////////////
                // set search location when dropdown item is selected
                /////////////////////////////////////////////////////////

                function SetSearchLocationOnEnterOrSpace(event)
                {
                    var e = event || window.event;
                    var code = e.charCode || e.keyCode;
                    /* console.log(code); */
                    if (code == 13 || code == 10 || code == 32)
                    {
                        return SetSearchLocation($(this));
                    }
                }
                function SetSearchLocationOnClick(event)
                {
                    return SetSearchLocation($(this));
                }
                function SetSearchLocation(element)
                {
                    // get rid of selected class on old selection
                    var selIndex = $get('searchLoc').value;
                    if (selIndex)
                    {
                        var sel = window.opts.item(parseInt(selIndex));
                        $(sel).attr('aria-checked', 'false');
                    }
                    // store this as the selected item and add selected class to it
                    $get('searchLoc').value = element.index();
                    selIndex = $get('searchLoc').value;
                    var sel = window.opts.item(parseInt(selIndex));
                    $(sel).attr('aria-checked', 'true');
                    $('#SearchLocationDropDown').attr('aria-activedescendant', $(sel).attr('id'));
                }

                // attach handlers to all of the dropdown items
                window.opts = $get('_ctl7').getElementsByTagName('li');
                for (i = 0; i < window.opts.length; i++)
                {
                    window.opts.item(i).onclick = SetSearchLocationOnClick;
                    window.opts.item(i).onkeydown = SetSearchLocationOnEnterOrSpace;
                    window.opts.item(i).onpress = SetSearchLocationOnEnterOrSpace;
                }
                // by default, select 'current folder'
                $get('searchLoc').value = 0;
                var selIndex = $get('searchLoc').value;
                var sel = window.opts.item(parseInt(selIndex));
                $(sel).attr('aria-checked', 'true');
                $('#SearchLocationDropDown').attr('aria-activedescendant', $(sel).attr('id'));
            });

            </script>
