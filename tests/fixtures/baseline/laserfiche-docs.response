      function ToggleSectionVis(id , srcId) {
      try {
        var el = document.getElementById(id);
        var imgEl = document.getElementById(srcId).childNodes[0];
        if(el) { el.style.display = (el.style.display == 'none') ? '' : 'none'; }
          if(imgEl) {
            imgEl.parentNode.title = (imgEl.src.toLowerCase().indexOf('uparrowcollapse.png') == -1) ? 'Hide' :  'Show';
            if (imgEl.src.toLowerCase().indexOf('uparrowcollapse.png') == -1) {
            imgEl.src = 'images/new_sprite/upArrowCollapse.png';
            imgEl.alt = 'Collapse';
            $(imgEl.parentNode).attr('aria-expanded', "true");
          }
          else {
            imgEl.src = 'images/downArrowExpand.png';
            imgEl.alt = 'Expand';
            $(imgEl.parentNode).attr('aria-expanded', "false");
          }
        }
      } catch(e) { }
      return false;
      }
      
      function SetTooltip(id, srcId, val) {
      try {
      var el = document.getElementById(id);
      var imgEl = document.getElementById(srcId).childNodes[0];
      if(imgEl) {
      imgEl.parentNode.title = val;
      }
      } catch(e) { }
      }
      SetTooltip('__MetadataDataSection','__MetadataExpando','Hide');
      SetTooltip('__PropertiesDataSection','__PropertiesExpando','Hide');
    </script></div></span>
