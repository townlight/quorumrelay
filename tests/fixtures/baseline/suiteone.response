<script>
    $(document).ready(function () {
        var mode = '0';
        if (mode == 1) //if compact mode
        {
            $('.upcomingEventsTable').DataTable({
                "bPaginate": false,
                "bFilter": false,
                "bInfo": false,
                order: [[1, 'asc']],
                "columnDefs": [
                    { targets: [0], className: "dt-left", className: "column1", orderable: false },
                    { targets: [1], className: "dt-center", className: "column2" },
                ],
            });
        }
        else {
            $('.upcomingEventsTable').DataTable({
                "bPaginate": false,
                "bFilter": false,
                "bInfo": false,
                order: [[1, 'asc']],
                "columnDefs": [
                    { targets: [0], className: "dt-left", className: "column1", orderable: false },
                    { targets: [1], className: "dt-center", className: "column2" },
                    { targets: [2], className: "dt-center", className: "column3", orderable: false },
                    { targets: [3], className: "dt-center", className: "column4", orderable: false },
                    { targets: [4], className: "dt-center", className: "column5", orderable: false },
                    { targets: [5], className: "dt-center", className: "column5", orderable: false },
                ],
            });
        }
    });
</script>

<!--RecentEvents section-->
<section id="recentEvents" class="section">
    <div class="main-container">
        <div class="inside-container" aria-label="Recent events">
            <div class="row" style="border: dashed silver 1px;padding:10px; ">
                <h2>Search Meetings</h2>
<form action="/Home/SearchEvents" id="searchEventsForm" method="get">                    <div class="form-inline">
                        <div class="form-group">
                            <div class="input-group" style="width:100%">
                                <label for="ev-search">Search</label>
                                <input type="text" placeholder="by Keyword or Phrase" id="ev-search" name="ev-search" value="" class="form-control" aria-label="Keyword or Phrase" />
                            </div>
                        </div>
                        <div class="form-group" style="">
                            <div class="input-group" style="width:100%">
                                <label for="dateFrom">Date From</label>
                                <input type='text' class="form-control" id="dateFrom" placeholder="From" autocomplete="off" name="dateFrom" value="01/01/2025" aria-label="Date From" />
                            </div>
                        </div>
                        <div class="form-group" style="">
                            <div class="input-group" style="width:100%">
                                <label for="dateTo">Date To</label>
                                <input type='text' class="form-control" id="dateTo" name="dateTo" autocomplete="off" placeholder="To" value="" aria-label="Date To" />
                            </div>
                        </div>
                        <div class="form-group evCategories">
                            <label for="evCategories">Categories</label>
                            <div class="input-group" style="width:100%; margin-top:4px;">
                                <select id="evCategories" class="form-control select2 ev-categories" aria-label="Select Category" style="background-color:white;">
                                    <option value="-1" selected>All Meetings</option>
                                            <option value="26">
                                                City Council
                                            </option>
                                            <option value="27">
                                                City Council Work Session
                                            </option>
                                            <option value="24">
                                                General
                                            </option>
                                            <option value="28">
                                                Planning &amp; Zoning
                                            </option>

                                </select>
                            </div>
                        </div>

                        <input type="submit" class="btn btn-warning recentEvents-search" style="margin-top: 30px; margin-left: 5px; padding: 7px 30px;" id="ev-search-btn" value="search" title="Search" aria-label="Search" />
                        <script type="text/javascript">
                            $(document).ready(function () {
                                $('#dateFrom').datepicker({ dateFormat: 'mm/dd/yy', changeMonth: true, changeYear: true });
                                $('#dateTo').datepicker({ dateFormat: 'mm/dd/yy', changeMonth: true, changeYear: true, });

                                $("#evCategories").select2({ placeholder: { id: '', text: "Select Category" }, allowClear: false});
                                $(".select2-selection__rendered").attr("title", "");
                            });
                        </script>
                        <div class="spinner-grow  text-info recent-ev-loader" aria-live="polite" style="display:none;" role="status">
                            <span class="sr-only">Loading search results...</span>
                        </div>
                    </div>
</form>            </div>
