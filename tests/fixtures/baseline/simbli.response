    async function fnMeetingEmailNotification() {
      try {
      
        const authToken = getCoreAuthTokenFromCookies();
        var url = '/CoreServices/api/NotificationPermission/CanAccessMeetingEmailNotification/?sid=' + encrSiteId + '&uid=' + enCuUID; // Replace with your actual API endpoint

        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          }
        });

        if (!response.ok) {
          //throw new Error('Network response was not ok');
          document.getElementById('dvNotificationSubscribe').style.display = 'none';
        }
        else {
          const data = await response.json(); 
          if (data === true  || data === 'true' || data === 'True') {
            document.getElementById('dvNotificationSubscribe').style.display = 'block';
          } else {
            //console.log('No access to email notification');
            document.getElementById('dvNotificationSubscribe').style.display = 'none';
          }
        }
        

      } catch (error) {
        console.error('Error occurred:', error);
        // Optionally display error message on the page
        document.getElementById('dvNotificationSubscribe').style.display = 'none'; // Show error notification
      }
    }

    $(document).ready(function () {
      meetingCustGrd.ListingType = '0';

