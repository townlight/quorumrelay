<style type="text/css">
.dvOverlay {
  position: fixed;
  width: 100%;
  height: 100%;
  background: rgba(137,137,137,0.8);
  top: 0;
  left: 0;
  z-index: 9999998;
  display: none;
}

div.contentWrapAdaPP {
  position: fixed;
  top: 50%;
  background: #fff;
  width: 800px;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
  transform: translate(-50%, -50%);
  border-radius: 10px;
  box-shadow: 0 1px 15px #a8a8a8;
  box-sizing: border-box;
  padding: 14px 18px 13px 20px;
  z-index: 9999999;
  display: none;
}

.pp-header {
  background: #fff;
  color: #000;
  font-size: 16px;
  text-align: left;
  box-sizing: border-box;
  padding: 5px 0px;
  line-height: 18px;
  float: left;
  width: 100%;
  position: relative;
}

.pp-header .close-btn {
  background: #ffffff;
  border: 2px solid transparent;
  cursor: pointer;
  color: #000000;
  font-size: 14px;
  padding: 2px;
  position: absolute;
  right: 0px;
  top: 5px;
  border-radius: 4px;
}

.pp-content {
  background: #fff;
  color: #000;
  font-weight: normal;
  text-align: left;
  box-sizing: border-box;
  max-height: calc(100vh - 164px);
  overflow: auto;
  float: left;
  width: 100%;
}

.pp-content p, .pp-content li, .pp-content span, .pp-content strong {
  font-size: 14px;
  font-family: Lato;
  line-height: 20px;
}

.pp-header h2 {
  float: left;
  max-width: calc(100% - 29px);
}

  .pp-header h2, .pp-content h3 {
    font-size: 17px;
    font-family: Lato Bold;
  }

.pp-content h4 {
  font-size: 16px;
  font-family: Lato;
  font-weight: normal;
  color: #000000;
  margin: 10px 0;
}

.pp-content:focus {
  outline-offset: -2px !important;
}


.pp-content a {
  color: #3c7d8d !important;
  text-decoration: underline;
  cursor: pointer;
  font-family: Lato Bold;
}

.pp-content a:hover {
  color: #2c5d6d !important;
  text-decoration: underline;
}

.dvOverlay.show {
  display: block !important;
}

.contentWrapAdaPP.show {
  display: block !important;
}


@media screen and ( max-width: 1100px ) {
  div.contentWrapAdaPP {
    width: 98%;
  }
}

@media screen and ( max-width:767px ) {
  div.contentWrapAdaPP {
    width: 100%;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    margin: 0px !important;
    transform: translate(0, 0) !important;
  }
}
</style>


<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
  var overlay = document.querySelector('.dvOverlay');
  var contentWrap = document.querySelector('.contentWrapAdaPP');
  var closeBtn = document.querySelector('.close-btn');
  var adaButtons = document.querySelectorAll('button[aria-controls="adaDisclaimerPPDV"]');
  var ppHeading = document.querySelector('.ppHeading');
  var previousActiveElement = null;
  
  // Get all focusable elements within the dialog
  function getFocusableElements() {
    return contentWrap.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
  }
  
  // Focus trap - keep focus within dialog when open
  function handleTabKey(e) {
    if (!contentWrap.classList.contains('show')) return;
    
    var focusableElements = getFocusableElements();
    var firstElement = focusableElements[0];
    var lastElement = focusableElements[focusableElements.length - 1];
    
    if (e.shiftKey) {
      // Shift + Tab
      if (document.activeElement === firstElement) {
        e.preventDefault();
        lastElement.focus();
      }
    } else {
      // Tab
      if (document.activeElement === lastElement) {
        e.preventDefault();
        firstElement.focus();
      }
    }
  }

  // Open dialog when any ADA button is clicked
  if (adaButtons && adaButtons.length > 0) {
    adaButtons.forEach(function(adaButton) {
      adaButton.addEventListener('click', function(e) {
        e.preventDefault();
        previousActiveElement = document.activeElement;
        
        if (overlay) overlay.classList.add('show');
        if (contentWrap) contentWrap.classList.add('show');
        if (ppHeading) ppHeading.focus();
        
        // Add keyboard event listener for focus trap
        document.addEventListener('keydown', handleTabKey);
      });
    });
  }

  // Close dialog when close button is clicked
  if (closeBtn) {
    closeBtn.addEventListener('click', function(e) {
      e.preventDefault();
      closeDialog();
    });
  }

  // Close dialog when overlay is clicked
  if (overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) {
        closeDialog();
      }
    });
  }

  // Close dialog on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && contentWrap && contentWrap.classList.contains('show')) {
      closeDialog();
    }
  });
  
  function closeDialog() {
    if (overlay) overlay.classList.remove('show');
    if (contentWrap) contentWrap.classList.remove('show');
    
    // Remove focus trap listener
    document.removeEventListener('keydown', handleTabKey);
    
    // Restore focus to the button that opened the dialog
    if (previousActiveElement) {
      previousActiveElement.focus();
    }
  }
});
</script>



<div class="dvOverlay" aria-hidden="true"></div>
<div class="contentWrapAdaPP" role="dialog" aria-modal="true" aria-labelledby="modalACGTitle" aria-describedby="modalACGDesc" id="adaDisclaimerPPDV">
  <div class="pp-header">
    <button type="button" class="close-btn" aria-label="Close ADA Compliance Guidelines Dialog" tabindex="0">
      <img src="/SB_Assets/images/light_close_icon.png" alt="" aria-hidden="true" width="24" />
    </button>
    <h2 tabindex="0" id="modalACGTitle" class="ppHeading">ADA Compliance Guidelines</h2>
  </div>
  <div class="pp-content" tabindex="0">
    <div class="w-100 float-left mt-1 mb-2">
      <p id="modalACGDesc">
        Review the ADA Compliance requirements below before customizing your site content.<br>
        Details can be found at
        <a href="https://www.w3.org/TR/WCAG22/" target="_blank" rel="noopener">
          Web Content Accessibility Guideline
        </a>
      </p>
    </div>
    <h3 class="mt-2 float-left w-100">ADA Compliance Responsibility</h3>
    <div class="w-100 float-left mt-1">
      <p>
        Federal accessibility standards require that web content be accessible to users with disabilities. This happens in 2 ways:</p>
    </div>
    <div class="w-100 float-left">
        <h4 class="pr-1 mb-2">1. Simbli Responsibilities:</h4>
        <p>Simbli is responsible to make sure the framework of the application is accessible. That the end users can zoom in on a page and see the data they need. Or that screen readers can read the content appropriately and that each page is structured so that a disabled person can get to the content they need quickly and effectively.</p>
        <h4 class="pr-1 mb-2">2. Simbli Customer Content Creator Responsibilities:</h4>
        <p>As a Simbli site administrator, ensure your content choices meet requirements to provide equal access to all users. This will include but not limited to the following:</p>
        <ul type="disc" class="pl-4">
          <li>Contrasting colors - The user can manage through Simbli Site Administration.</li>
          <li>Documents - If documents are attached, like a PDF file, that the structure would be WCAG2.2 compliant.</li>
          <li>Video - The attached video's would need to meet WCAG2.2 standards.</li>
          <li>Pictures within documents have appropriate tags.</li>
          <li>Structure of content within a module would be structured appropriately to the framework.</li>
        </ul>
    </div>
  </div>
</div>


    </div>
