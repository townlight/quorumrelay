isability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":896,"timezone":258},"2026-09-09 18:20:20",[898,899,900,901,902,903,904,905],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":907,"type":127,"data":908},"Bc6VgrnSZj",{"text":909,"level":147},"5f. Approval of Dynamic Controls Inc. (DCI) Service Agreement",{"id":911,"type":150,"data":912},"rUTvn0zWV5",{"text":913},"Presented by: John Woodruff, with supporting memo and proposed agreement included in the Board Packet.",{"id":915,"type":150,"data":916},"N7F4YKDA8_",{"text":578},{"id":918,"type":195,"data":919},"TBGVUdflG5",{"style":197,"items":920},[921,922,923,924,925],"Vendor DCI provides hardware and software for remote control of all HVAC units at the Mattoon main campus and at the Kluthe Center, regulating temperatures and air quality.","Agreement also covers aging hardware upgrades. Because of the proprietary nature of this system, this agreement is exempt from bidding per Policy 10.22 (#4. E.).","DCI additionally provides the college's security/proximity card and door locking system. A future upgrade to this system will be brought to the Board at a later date.","Term: Two years — October 1, 2026 – September 30, 2028","Total Cost: $106,352 ($53,176/year) — approximately 5% over the previous agreement.",{"id":927,"type":205,"data":928},"c48L8Dl2Mv",{"text":929,"linkedMotionId":930,"motionSnapshot":931,"parent":222,"child":222},"\u003Cp>Approve as presented the two-year service agreement with Dynamic Controls, Inc. of East Peoria, Illinois, with a total contract value of $106,352 or $53,176 per year.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Wyatt Draper\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8866,{"id":930,"motion_text":932,"decision":211,"notes":14,"moved_by_user":933,"seconded_by_user":936,"created_at":952,"votes":954},"Approve as presented the two-year service agreement with Dynamic Controls, Inc. of East Peoria, Illinois, with a total contract value of $106,352 or $53,176 per year.",{"id":643,"name":86,"email":644,"slug":645,"created_at":646,"updated_at":217,"first_name":647,"last_name":648,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":649,"avatar_url":225,"summary":934,"profile":935},{"format":227,"first_name":647,"last_name":648,"email":644,"image":225,"name":86,"slug":645},{"id":652,"user_id":643,"organization_id":34,"title":14,"company":14,"contact_email":644,"contact_phone":653,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":654,"created_at":646,"updated_at":655,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":656,"introduced":222,"board_term_from":657,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":659,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":130,"veteran_status":4