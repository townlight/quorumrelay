1006,1007,1008],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1010,"type":127,"data":1011},"F_nUvk1zLL",{"text":1012,"level":147},"5h. Approval of Bid for Effingham Technology Center Cleaning",{"id":1014,"type":150,"data":1015},"9N5RTrieap",{"text":1016},"Presented by: John Woodruff, with supporting memo and bid tabulation sheet included in the Board Packet.",{"id":1018,"type":150,"data":1019},"Xoom8vnR2B",{"text":578},{"id":1021,"type":195,"data":1022},"h1krIqnJIL",{"style":197,"items":1023},[1024,1025,1026,1027],"Current cleaning contract is expiring. Two bids were received, with an option for full building or main/bottom floors only, and a month-to-month structure.","Low bidder and current vendor: ESS Clean Inc., Urbana, Illinois","Update: Two internal custodial candidates have been identified to potentially staff the ETC, which may reduce or eliminate the need for the full contract. ESS agreement requires 30-day notice for cancellation.","Cost: Not to exceed $115,000 annually on a month-to-month basis.",{"id":1029,"type":205,"data":1030},"Vw0449DMyI",{"text":1031,"linkedMotionId":1032,"motionSnapshot":1033,"parent":222,"child":222},"\u003Cp>Approve as presented the proposal to utilize ESS Clean Inc. of Urbana, for cleaning all three floors of the Effingham Technology Center. The annual cost associated with the month-to-month agreement is not to exceed $115,000.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Chuck Deters\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8859,{"id":1032,"motion_text":1034,"decision":211,"notes":14,"moved_by_user":1035,"seconded_by_user":1038,"created_at":1041,"votes":1043},"Approve as presented the proposal to utilize ESS Clean Inc. of Urbana, for cleaning all three floors of the Effingham Technology Center. The annual cost associated with the month-to-month agreement is not to exceed $115,000.",{"id":213,"name":68,"email":214,"slug":215,"created_at":216,"updated_at":217,"first_name":218,"last_name":219,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":224,"avatar_url":225,"summary":1036,"profile":1037},{"format":227,"first_name":218,"last_name":219,"email":214,"image":225,"name":68,"slug":215},{"id":229,"user_id":213,"organization_id":34,"title":14,"company":14,"contact_email":214,"contact_phone":230,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":14,"created_at":216,"updated_at":231,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":235,"introduced":222,"board_term_from":236,"board_term_to":237,"email_notification_frequency":238,"notifications_opened_at":231,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":222,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":643,"name":86,"email":644,"slug":645,"created_at":646,"updated_at":217,"first_name":647,"last_name":648,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":649,"avatar_url":225,"summary":1039,"profile":1040},{"format":227,"first_name":647,"last_name":648,"email":644,"image":225,"name":86,"slug":645},{"id":652,"user_id":643,"organization_id":34,"title":14,"company":14,"contact_email":644,"contact_phone":653,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":654,"created_at":646,"updated_at":655,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":656,"introduced":222,"board_term_from":657,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":659,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":1042,"timezone":258},"2026-09-04 13:21:27",[1044,1045,1046,1047,1048,1049,1050,1051],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1053,"type":127,"data":1054},"IYEH9jM4_T",{"text":1055,"level":147},"5i. Approval of Resolution No. 0926-003 — General Obligation Debt Certificates (Not to Exceed $20,100,000)",{"id":1057,"type":150,"data":1058},"tFkuq_7rY3",{"text":1059},"Presented by Trustee Larry Lilly and John Woodruff, with a supporting memo and the proposed resolution included in the Board Packet.",{"id":1061,"type":150,"data":1062},"IRARkoDxJd",{"text":578},{"id":1064,"type":195,"data":1065},"YsamoSBrJi",{"style":197,"items":1066},[1067,1068,1069,1070,1071],"These debt certificates are mainly for capital improvement projects only — not for operating expenses. Projects include facility renovation, repair, equipment, and site improvements over the next four years.","This resolution is the first step in the bonding process. Following Board approval, a bank will take on the debt (term approximately 90–120 days), after which the college will complete the formal bond process to retire the debt certificates.","Several banks expressed interest during preliminary outreach conducted weeks prior.","No tax increase required — bond payments will match the current payment schedule, as the college's existing bonds are fully paid off at year-end.","Trustee Lilly said the Finance Committee met on September 10th to review Resolution No. 0926-003 and the Committee recommends Board approval as presented. ",{"id":1073,"type":205,"data":1074},"lOG9ut_wUP",{"text":1075,"linkedMotionId":1076,"motionSnapshot":1077,"parent":222,"child":222},"\u003Cp>Approve as presented Resolution No. 0926-003 – Resolution authorizing and providing for the issue of not to exceed $20,100,000 General Obligation Debt Certificates (Limited Tax), Series 2026, for the purpose of renovating, repairing and equipping District facilities and improving sites, authorizing an Installment Purchase Agreement and authorizing the proposed sale of said certificates to the purchaser thereof.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Gary Cadwell\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Doris Reynolds\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8887,{"id":1076,"motion_text":1078,"decision":211,"notes":14,"moved_by_user":1079,"seconded_by_user":1082,"created_at":1085,"votes":1087},"Approve as presented Resolution No. 0926-003 – Resolution authorizing and providing for the issue of not to exceed $20,100,000 General Obligation Debt Certificates (Limited Tax), Series 2026, for the purpose of renovating, repairing and equipping District facilities and improving sites, authorizing an Installment Purchase Agreement and authorizing the proposed sale of said certificates to the purchaser thereof.",{"id":717,"name":66,"email":718,"slug":719,"created_at":720,"updated_at":721,"first_name":722,"last_name":723,"two_factor_auth":724,"country_code":44,"phone":725,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":726,"avatar_url":225,"summary":1080,"profile":1081},{"format":227,"first_name":722,"last_name":723,"email":718,"image":225,"name":66,"slug":719},{"id":729,"user_id":717,"organization_id":34,"title":14,"company":14,"contact_email":730,"contact_phone":731,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":730,"created_at":720,"updated_at":732,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":733,"introduced":222,"board_term_from":44,"board_term_to":44,"email_notification_frequency":238,"notifications_opened_at":734,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":735,"task_reminder":130,"hide_document_left_panel":222,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":737,"name":84,"email":738,"slug":739,"created_at":740,"updated_at":217,"first_name":741,"last_name":742,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":743,"avatar_url":225,"summary":1083,"profile":1084},{"format":227,"first_name":741,"last_name":742,"email":738,"image":225,"name":84,"slug":739},{"id":746,"user_id":737,"organization_id":34,"title":14,"company":14,"contact_email":738,"contact_phone":747,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":748,"created_at":740,"updated_at":749,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":750,"introduced":222,"board_term_from":751,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":44,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":752,"task_reminder":130,"hide_document_left_panel":222,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":1086,"timezone":258},"2026-09-09 16:32:12",[1088,1089,1090,1091,1092,1093,1094,1095],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1097,"type":127,"data":1098},"MipL17eax4",{"text":1099,"level":147},"5j. Deletion of Board Policy 05.04.16 — Sabbatical Leave for Administrators and Supervisors",{"id":1101,"type":150,"data":1102},"qvk4rE4BsI",{"text":1103},"Presented by John Woodruff, with supporting memo from Dustha Wahls, Director of Human Resources, and proposed policy deletion in the Board Packet.",{"id":1105,"type":150,"data":1106},"lHEavpXsWv",{"text":578},{"id":1108,"type":195,"data":1109},"ZbPdIgNJzO",{"style":197,"items":1110},[1111,1112,1113],"Board Policy 05.04.16 established a sabbatical leave program for full-time administrators with at least 6 years of service at Lake Land College.","This policy has not been utilized in recent times.","Recommendation: Delete the policy to remove an unfunded liability obligation and eliminate the potential to accrue for this benefit.",{"id":1115,"type":205,"data":1116},"aLnq7dS7rt",{"text":1117,"parent":222,"child":222},"\u003Cp>Waive first reading and remove Board Policy 05.04.16 Sabbatical Leave for Administrators as an approved policy.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Scott Montgomery\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",{"id":1119,"type":127,"data":1120},"IKH11daWs7",{"text":1121,"level":147},"5k. Approval of Purchase of Forklift Simulators for Three Illinois Department of Corrections Educational Program",{"id":1123,"type":150,"data":1124},"7E1W0xCYaE",{"text":1125},"Presented by: Dr. Bullock, with supporting memo from Brandon Young, Dean of Correctional Programs, and proposed purchase quotes included in the Board Packet.",{"id":1127,"type":150,"data":1128},"AjJa36TYQ6",{"text":578},{"id":1130,"type":195,"data":1131},"DXKpo1GTn1",{"style":197,"items":1132},[1133,1134,1135,1136],"Three sit-down forklift simulators to be purchased for warehousing programs at: Decatur Correctional Center; Illinois River Correctional Center; Southwestern Correctional Center.","Vendor: Moss Enterprises, 5530 W. Parkway, Suite 100, Johnston, Iowa (sole SimLog distributor in the area; no bidding required)","Total Cost: $199,179 (funded through Perkins dollars allocated to Department of Corrections; approved by DOC)","Optional SimLog training ($600/unit) was not included in the purchase.",{"id":1138,"type":205,"data":1139},"MrNYeWC5nD",{"text":1140,"linkedMotionId":1141,"motionSnapshot":1142,"parent":222,"child":222},"\u003Cp>Approve as presented purchase of Forklift Simulators in the amount of $199,179.  On each quote, the optional $600 Simlog training will not be purchased. Purchase will be made from Moss Enterprises, 5530 West Parkway, Ste 100, Johnston, IA, 50131.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Chuck Deters\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Doris Reynolds\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8830,{"id":1141,"motion_text":1143,"decision":211,"notes":14,"moved_by_user":1144,"seconded_by_user":1147,"created_at":1151,"votes":1153},"Approve as presented purchase of Forklift Simulators in the amount of $199,179.  On each quote, the optional $600 Simlog training will not be purchased. Purchase will be made from Moss Enterprises, 5530 West Parkway, Ste 100, Johnston, IA, 50131.",{"id":213,"name":68,"email":214,"slug":215,"created_at":216,"updated_at":217,"first_name":218,"last_name":219,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":224,"avatar_url":225,"summary":1145,"profile":1146},{"format":227,"first_name":218,"last_name":219,"email":214,"image":225,"name":68,"slug":215},{"id":229,"user_id":213,"organization_id":34,"title":14,"company":14,"contact_email":214,"contact_phone":230,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":14,"created_at":216,"updated_at":231,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":235,"introduced":222,"board_term_from":236,"board_term_to":237,"email_notification_frequency":238,"notifications_opened_at":231,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":222,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":737,"name":84,"email":738,"slug":739,"created_at":740,"updated_at":217,"first_name":741,"last_name":742,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":743,"avatar_url":225,"summary":1148,"profile":1149},{"format":227,"first_name":741,"last_name":742,"email":738,"image":225,"name":84,"slug":739},{"id":746,"user_id":737,"organization_id":34,"title":14,"company":14,"contact_email":738,"contact_phone":747,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":748,"created_at":740,"updated_at":749,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":1150,"introduced":222,"board_term_from":751,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":44,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":752,"task_reminder":130,"hide_document_left_panel":222,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},"2026-09-21 16:15:34",{"date":1152,"timezone":258},"2026-09-02 20:12:08",[1154,1155,1156,1157,1158,1159,1160,1161],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1163,"type":127,"data":1164},"JlwwJkOXBD",{"text":1165,"level":147},"5l. Approve Elimination of TRIO Destination College Positions Contingent on Grant Award Outcome",{"id":1167,"type":150,"data":1168},"TdhVk9x30R",{"text":1169},"Presented by: Heather Nohren, with supporting memo in the Board Packet.",{"id":1171,"type":150,"data":1172},"fn6ogPqkYD",{"text":578},{"id":1174,"type":195,"data":1175},"ho8zYtEgPu",{"style":197,"items":1176},[1177,1178,1179,1180,1181,1182],"Lake Land College was not included in the first slate of TRIO Talent Search Grant awards for the upcoming 5-year grant cycle due to federal funding reductions impacting approximately 200 colleges nationally.","Lake Land College scored 104 points; the first-slate threshold was 105 points.","A second and final slate of awards is expected by September 30th. The college is in a strong position to be included.","If the grant is not awarded, the following two full-time positions must be eliminated effective October 1, 2026: TRIO Destination College Outreach Advisor; TRIO Outreach and Retention Specialist.","Note: The college's other two TRIO grants (TRIO SSS and TRIO STEM), which serve approximately 300–350 students on campus, are unaffected and have four years remaining.","The TRIO Talent Search grant primarily supports middle and high school students.",{"id":1184,"type":205,"data":1185},"Xtgsz-fre5",{"text":1186,"linkedMotionId":1187,"motionSnapshot":1188,"parent":222,"child":222},"\u003Cp>Motion to approve elimination of TRIO Destination College Outreach &amp; Retention Specialist and TRIO Destination College Outreach Advisor full-time employment positions due to loss of TRIO Talent Search grant funding, effective October 1, 2026, subject to the TRIO Talent Search grant funding not being awarded to the College for the next five-year grant cycle.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Doris Reynolds\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8856,{"id":1187,"motion_text":1189,"decision":211,"notes":14,"moved_by_user":1190,"seconded_by_user":1193,"created_at":1196,"votes":1198},"Motion to approve elimination of TRIO Destination College Outreach &amp; Retention Specialist and TRIO Destination College Outreach Advisor full-time employment positions due to loss of TRIO Talent Search grant funding, effective October 1, 2026, subject to the TRIO Talent Search grant funding not being awarded to the College for the next five-year grant cycle.",{"id":737,"name":84,"email":738,"slug":739,"created_at":740,"updated_at":217,"first_name":741,"last_name":742,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":743,"avatar_url":225,"summary":1191,"profile":1192},{"format":227,"first_name":741,"last_name":742,"email":738,"image":225,"name":84,"slug":739},{"id":746,"user_id":737,"organization_id":34,"title":14,"company":14,"contact_email":738,"contact_phone":747,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":748,"created_at":740,"updated_at":749,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":1150,"introduced":222,"board_term_from":751,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":44,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":752,"task_reminder":130,"hide_document_left_panel":222,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":643,"name":86,"email":644,"slug":645,"created_at":646,"updated_at":217,"first_name":647,"last_name":648,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":649,"avatar_url":225,"summary":1194,"profile":1195},{"format":227,"first_name":647,"last_name":648,"email":644,"image":225,"name":86,"slug":645},{"id":652,"user_id":643,"organization_id":34,"title":14,"company":14,"contact_email":644,"contact_phone":653,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":654,"created_at":646,"updated_at":655,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":656,"introduced":222,"board_term_from":657,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":659,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":1197,"timezone":258},"2026-09-03 20:11:44",[1199,1200,1201,1202,1203,1204,1205,1206],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1208,"type":127,"data":1209},"mG-HJ7Y2Dt",{"text":1210,"level":147},"5m. Approval for Renewal of the Liquidware Maintenance Agreement",{"id":1212,"type":150,"data":1213},"MYtRVbdEMD",{"text":1214},"Presented by: John Woodruff, with supporting memo from David Stewart, Chief Information Officer, and the proposed renewal agreement included in the Board Packet.",{"id":1216,"type":150,"data":1217},"ukFCTa9fjF",{"text":578},{"id":1219,"type":195,"data":1220},"DMpL80miGe",{"style":197,"items":1221},[1222,1223,1224,1225,1226],"Administration recommends approval of a two-year renewal agreement with Liquidware Labs for ProfileUnity and FlexApp enterprise licensing and support at a total cost of $30,000. "," The renewal provides licensing and support for 500 concurrent users from March 6, 2027, through March 6, 2029. ","These products help centrally manage user profiles, settings, and applications while providing employees and students with a consistent experience when accessing College virtual desktops.","IT is seeking approval to renew the maintenance agreement for a period of two years, and up-front payment for both years will be required. After negotiation, the cost of the two-year agreement is $30,000. The cost was discounted from $78,650 to $30,000 for the two-year agreement, resulting in savings of $48,650, or approximately 62%.","This is exempt from bidding per Board Policy 10.22 (#4. F.).",{"id":1228,"type":205,"data":1229},"l2CjgUXCcY",{"text":1230,"linkedMotionId":1231,"motionSnapshot":1232,"parent":222,"child":222},"\u003Cp>Approve as presented the proposed renewal of a two-year renewal agreement with Liquidware Labs of Alpharetta, Georgia for ProfileUnity and FlexApp enterprise licensing and support for 500 concurrent users, covering March 6, 2027, through March 6, 2029, at a total cost of $30,000.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Scott Montgomery\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8888,{"id":1231,"motion_text":1233,"decision":211,"notes":14,"moved_by_user":1234,"seconded_by_user":1237,"created_at":1240,"votes":1242},"Approve as presented the proposed renewal of a two-year renewal agreement with Liquidware Labs of Alpharetta, Georgia for ProfileUnity and FlexApp enterprise licensing and support for 500 concurrent users, covering March 6, 2027, through March 6, 2029, at a total cost of $30,000.",{"id":643,"name":86,"email":644,"slug":645,"created_at":646,"updated_at":217,"first_name":647,"last_name":648,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":649,"avatar_url":225,"summary":1235,"profile":1236},{"format":227,"first_name":647,"last_name":648,"email":644,"image":225,"name":86,"slug":645},{"id":652,"user_id":643,"organization_id":34,"title":14,"company":14,"contact_email":644,"contact_phone":653,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":654,"created_at":646,"updated_at":655,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":656,"introduced":222,"board_term_from":657,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":659,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":242,"name":78,"email":243,"slug":244,"created_at":245,"updated_at":217,"first_name":246,"last_name":247,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":248,"avatar_url":225,"summary":1238,"profile":1239},{"format":227,"first_name":246,"last_name":247,"email":243,"image":225,"name":78,"slug":244},{"id":251,"user_id":242,"organization_id":34,"title":14,"company":14,"contact_email":243,"contact_phone":252,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":14,"created_at":245,"updated_at":253,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":254,"introduced":222,"board_term_from":236,"board_term_to":237,"email_notification_frequency":238,"notifications_opened_at":255,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":222,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":1241,"timezone":258},"2026-09-09 16:33:54",[1243,1244,1245,1246,1247,1248,1249,1250],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1252,"type":127,"data":1253},"7R9qCJQtk-",{"text":1254,"level":147},"5n. Approval of One-Year Renewal of Modern Campus Subscription",{"id":1256,"type":150,"data":1257},"BE59MdpVy0",{"text":1258},"Presented by: John Woodruff, with supporting memo from David Stewart and the proposed renewal invoice included in the Board Packet.",{"id":1260,"type":150,"data":1261},"XjSuSyFViE",{"text":578},{"id":1263,"type":195,"data":1264},"yyc8xXuwUa",{"style":197,"items":1265},[1266],"The Administration recommends renewing the College’s subscription with Modern Campus, Inc. for the Lifelong Learning Extended Education (LLL EE) platform.",{"id":1268,"type":195,"data":1269},"XjwqBzeiJv",{"style":197,"items":1270},[1271,1272,1226],"The renewal term runs from October 1, 2026, through September 30, 2027, at an annual cost of $33,547.97. ","Modern Campus provides the College with a robust continuing education and workforce development platform to manage registration, payments, and learner engagement for extended education programs.",{"id":1274,"type":205,"data":1275},"OGiuXGgB3F",{"text":1276,"linkedMotionId":1277,"motionSnapshot":1278,"parent":222,"child":222},"\u003Cp>Approve as presented the one-year renewal of the Lifelong Learning Extended Education subscription with Modern Campus of Toronto, Ontario at $33,547.97, with funding that has been incorporated into the FY27 IT budget. The renewal term runs from October 1, 2026 through September 30, 2027.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Gary Cadwell\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",8889,{"id":1277,"motion_text":1279,"decision":211,"notes":14,"moved_by_user":1280,"seconded_by_user":1283,"created_at":1286,"votes":1288},"Approve as presented the one-year renewal of the Lifelong Learning Extended Education subscription with Modern Campus of Toronto, Ontario at $33,547.97, with funding that has been incorporated into the FY27 IT budget. The renewal term runs from October 1, 2026 through September 30, 2027.",{"id":717,"name":66,"email":718,"slug":719,"created_at":720,"updated_at":721,"first_name":722,"last_name":723,"two_factor_auth":724,"country_code":44,"phone":725,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":726,"avatar_url":225,"summary":1281,"profile":1282},{"format":227,"first_name":722,"last_name":723,"email":718,"image":225,"name":66,"slug":719},{"id":729,"user_id":717,"organization_id":34,"title":14,"company":14,"contact_email":730,"contact_phone":731,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":730,"created_at":720,"updated_at":732,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":733,"introduced":222,"board_term_from":44,"board_term_to":44,"email_notification_frequency":238,"notifications_opened_at":734,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":735,"task_reminder":130,"hide_document_left_panel":222,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":643,"name":86,"email":644,"slug":645,"created_at":646,"updated_at":217,"first_name":647,"last_name":648,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":649,"avatar_url":225,"summary":1284,"profile":1285},{"format":227,"first_name":647,"last_name":648,"email":644,"image":225,"name":86,"slug":645},{"id":652,"user_id":643,"organization_id":34,"title":14,"company":14,"contact_email":644,"contact_phone":653,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":654,"created_at":646,"updated_at":655,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":656,"introduced":222,"board_term_from":657,"board_term_to":658,"email_notification_frequency":238,"notifications_opened_at":659,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":130,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":1287,"timezone":258},"2026-09-09 16:36:15",[1289,1290,1291,1292,1293,1294,1295,1296],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1298,"type":127,"data":1299},"TSoAyDgaQo",{"text":1300,"level":147},"5o. Waive First Reading and Approve Proposed Revisions to Board Policy 02.16 - Freedom of Information Act.",{"id":1302,"type":150,"data":1303},"TtXMFY5R4X",{"text":1304},"Presented by: Jean Anne Highland, with a supporting memo from Dustha Wahls and the proposed policy changes included in the Board Packet.",{"id":1306,"type":150,"data":1307},"XFSl6w2xCy",{"text":578},{"id":1309,"type":195,"data":1310},"kZcpVXwk5m",{"style":197,"items":1311},[1312,1313],"Board Policy 02.16 indicates the FOIA officers of the College. The College is requesting to swap the vacant position of Dean of Enrollment &amp; Student Success for the Director of Admissions &amp; Records. ","Since this is a technical change in titles, the Administration requested the Board waive first reading.  ",{"id":1315,"type":205,"data":1316},"o1A6F90td4",{"text":1317,"parent":222,"child":222},"\u003Cp>Waive first reading and approve proposed revisions to Board Policy 02.16 - Freedom of Information Act.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Scott Montgomery\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",{"id":1319,"type":127,"data":1320},"qVVz4v9eUV",{"text":1321,"level":147},"5p. Approval of Renewal of Fortinet Firewall Support",{"id":1323,"type":150,"data":1324},"MJg2Z9QWY4",{"text":1325},"Presented by: John Woodruff, with a supporting memo from David Stewart and the proposed renewal agreement provided to Trustees.",{"id":1327,"type":150,"data":1328},"CJuR2LTN6g",{"text":578},{"id":1330,"type":195,"data":1331},"CJcSvBEPHc",{"style":197,"items":1332},[1333,1334,1335,1336,1337],"IT recommends approval of the annual renewal of Fortinet Advanced Threat Protection (ATP) support for the College's firewall infrastructure at a cost of $30,984.54.","The renewal provides licensing and support for our firewalls from October 17, 2026, through October 17, 2027.","Lake Land College utilizes Fortinet firewalls as a critical component of its cybersecurity infrastructure to protect.","Vendor: Dell Technologies / Fortinet","Exempt from bidding per Board Policy 10.22 (4. F.)",{"id":1339,"type":205,"data":1340},"c7OyvOzYgH",{"text":1341,"linkedMotionId":1342,"motionSnapshot":1343,"parent":222,"child":222},"\u003Cp>Approve as presented the proposed renewal of a one-year renewal agreement with Fortinet ATP support for our firewalls through Dell Technologies of Round Rock, Texas, covering October 17, 2026, through October 17, 2027, at a total cost of $30,984.54. This renewal was not included in the FY2027 budget due to an oversight associated with the expiration of a previously prepaid five-year agreement.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Chuck Deters\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Scott Montgomery\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",9015,{"id":1342,"motion_text":1344,"decision":211,"notes":14,"moved_by_user":1345,"seconded_by_user":1348,"created_at":1351,"votes":1353},"Approve as presented the proposed renewal of a one-year renewal agreement with Fortinet ATP support for our firewalls through Dell Technologies of Round Rock, Texas, covering October 17, 2026, through October 17, 2027, at a total cost of $30,984.54. This renewal was not included in the FY2027 budget due to an oversight associated with the expiration of a previously prepaid five-year agreement.",{"id":213,"name":68,"email":214,"slug":215,"created_at":216,"updated_at":217,"first_name":218,"last_name":219,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":224,"avatar_url":225,"summary":1346,"profile":1347},{"format":227,"first_name":218,"last_name":219,"email":214,"image":225,"name":68,"slug":215},{"id":229,"user_id":213,"organization_id":34,"title":14,"company":14,"contact_email":214,"contact_phone":230,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":14,"created_at":216,"updated_at":231,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":235,"introduced":222,"board_term_from":236,"board_term_to":237,"email_notification_frequency":238,"notifications_opened_at":231,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":222,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"id":242,"name":78,"email":243,"slug":244,"created_at":245,"updated_at":217,"first_name":246,"last_name":247,"two_factor_auth":44,"country_code":44,"phone":44,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"email_2fa":44,"saml_only":222,"saml_last_login_at":44,"accepted_cookie_policy":14,"email_confirmed":130,"confirmation_email_expires_at":223,"confirmation_email_token":14,"has_password":33,"url":248,"avatar_url":225,"summary":1349,"profile":1350},{"format":227,"first_name":246,"last_name":247,"email":243,"image":225,"name":78,"slug":244},{"id":251,"user_id":242,"organization_id":34,"title":14,"company":14,"contact_email":243,"contact_phone":252,"bio":14,"twitter":14,"facebook":14,"linkedin":14,"image":14,"additional_notifications_email":14,"created_at":245,"updated_at":253,"deleted_at":44,"meeting_reminder":130,"board_role":232,"personal_address":14,"personal_address_2":14,"personal_city":14,"personal_state":14,"personal_zip":14,"personal_phone":14,"onboard":222,"invitation_status":233,"timezone":234,"extra":14,"send_notifications":130,"last_activity":254,"introduced":222,"board_term_from":236,"board_term_to":237,"email_notification_frequency":238,"notifications_opened_at":255,"last_api_activity":44,"birthday":44,"is_guest":222,"api_user":222,"api_key":44,"language":239,"signup_category":44,"race":44,"gender":44,"age":44,"pronoun":44,"education":44,"document_sort":240,"task_reminder":130,"hide_document_left_panel":130,"hide_document_right_panel":222,"veteran_status":44,"disability_status":44,"external_id":44,"ai_engagement_checks_enabled":222,"imageUrl":225},{"date":1352,"timezone":258},"2026-09-15 21:52:50",[1354,1355,1356,1357,1358,1359,1360,1361],{"user_name":66,"vote":261},{"user_name":68,"vote":261},{"user_name":78,"vote":261},{"user_name":84,"vote":261},{"user_name":86,"vote":261},{"user_name":90,"vote":261},{"user_name":76,"vote":261},{"user_name":70,"vote":261},{"id":1363,"type":127,"data":1364},"CONO4A6-V5",{"text":1365,"level":147},"5q. Closed Session",{"id":1367,"type":205,"data":1368},"sxUgUrxpDt",{"text":1369,"parent":222,"child":222},"\u003Cp>Pursuant to Chapter 5 of the IL Compiled Statutes, Section 120(c)(1) and (2), a closed session was called to discuss the appointment, employment, compensation, performance, discipline, or dismissal of specific employees and to discuss collective negotiating matters.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Doris Reynolds\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",{"id":1371,"type":150,"data":1372},"qUSzkaxxoT",{"text":1373},"Following closed session, the Board returned to open session and conducted a roll call at 8:09 p.m. Attendance was the same as noted at the beginning of the regular meeting.",{"id":1375,"type":127,"data":1376},"k3ixSSoo0B",{"text":1377,"level":147},"5r. Approval of Resolution No. 0926-002 to Approve Tenth Addendum to Employment Agreement with Dr. Jonathan “Josh” Bullock, Lake Land College President, Extending the Term through June 30, 2029, as Discussed in Closed Session.",{"id":1379,"type":150,"data":1380},"TRIbNvXXyR",{"text":1381},"The agenda item was noted that a complete copy of the proposed resolution and tenth addendum were available at:\u003Ca href=\"https://www.lakelandcollege.edu/board-of-trustees-employment-contracts/\" target=\"_blank\" rel=\"noreferrer noopener\"> https://www.lakelandcollege.edu/board-of-trustees-employment-contracts/ \u003C/a>or by contacting the College’s Office of the President at 217-234-5222.",{"id":1383,"type":205,"data":1384},"Wbx3a9_OB2",{"text":1385,"parent":222,"child":222},"\u003Cp>Approve as presented Resolution No. 0926-002 - Approving Tenth Addendum to Employment Agreement with Dr. Jonathan “Josh” Bullock, Lake Land College President, Extending the Term through June 30, 2029. This followed a discussion on the topic held in closed session.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Doris Reynolds\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Gary Cadwell\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",{"id":1387,"type":127,"data":1388},"OMOcXwOmkB",{"text":1389,"level":147},"5s. Approval of Human Resources Report as Discussed in Closed Session",{"id":1391,"type":205,"data":1392},"wbeNpg8_-G",{"text":1393,"parent":222,"child":222},"\u003Cp>Approve the Human Resources Report as presented. This followed a discussion on the topic held in closed session related only to an employee's retirement.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Denise Walk\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Doris Reynolds\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>",{"id":1395,"type":127,"data":1396},"GfqmVoKz1s",{"text":1397,"level":142},"6. Other Business",{"id":1399,"type":150,"data":1400},"z6q39ZLb54",{"text":1401},"No additional business was raised.",{"id":1403,"type":127,"data":1404},"JrKCbnJjYx",{"text":1405,"level":142},"7. Adjournment",{"id":1407,"type":205,"data":1408},"LaB0OUyBIz",{"text":1409,"linkedMotionId":1410,"motionSnapshot":1411,"parent":222,"child":222},"\u003Cp>Motion to adjourn.\u003C/p>\u003Cp>\u003Cspan>Moved by:\u003C/span> Gary Cadwell\u003Cbr />\u003Cspan>Seconded by:\u003C/span> Wyatt Draper\u003Cbr />\u003Cspan>Outcome:\u003C/span> Carried\u003C/p>\u003Cp>Gary Cadwell (Yes), Chuck Deters (Yes), Scott Montgomery (Yes), Doris Reynolds (Yes), Denise Walk (Yes), Tom Wright (Yes), Larry Lilly (Yes), Wyatt Draper (Yes)\u003C/p>\u003Cp>\u003Cspan>Notes:\u003C/span> Passed by unanimous voice vote of members present at 8:11 p.m.\u003C/p>",8705,{"id":1410,"motion_text":1412,"decision":211,"notes":1413,"moved_by_user":1414,"seconded_by_user":1417,"created_at":1420,"votes":1422},"Motion to adjourn.","Passed by unanimous voice vote of members present at 8:11 p.m.",{"id":717,"name":66,"email":718,"slug":719,"created_at":720,"updated_at":721,"first_name":722,"last_name":723,"two_factor_auth":724,"country_code":44,"phone":725,"hubspot_id":14,"locked_at":44,"image":14,"accepted_terms":220,"accepted_privacy_policy":221,"emai