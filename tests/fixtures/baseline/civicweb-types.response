				<div id="ctl00_MainContent_MeetingTypeRepeater_ctl13_ItemTemplate" class="item-template">
					<div id="ctl00_MainContent_MeetingTypeRepeater_ctl13_MeetingTypeLLabel">
						<div class="item-title meeting-type-title">
							<div class="admin-buttons meeting-type-edit-button">
								
							</div>
							<h2>
								
								<span id="ctl00_MainContent_MeetingTypeRepeater_ctl13_NonLinkTitle" href="#" class="meeting-type-item-title" style="color: #fff;">Sonoma Valley Health Care District Board of Directors </span>
							</h2>
						</div>
					</div>
					<div class="meeting-type-item item-content" style="padding-bottom: 0 !important">
						<div class="meeting-type-item-description item-description portal-item-description">
							<p style="text-align: left;">Sonoma Valley Hospital is governed under the Bylaws of the Sonoma Valley Health Care District by a publicly elected Board of Directors. For additional information, including meeting information, visit their website:&nbsp; &nbsp;<a href="https://www.sonomavalleyhospital.org/healthcare-district-information/board-of-directors/">https://www.sonomavalleyhospital.org/healthcare-district-information/board-of-directors/.</a></p>
<p style="text-align: justify;">&nbsp;</p>
<p style="text-align: justify;">The City of Sonoma is not responsible to post agendas or notices for the SVHCD and they will not be posted on the CivicWeb Portal.</p>
<p style="text-align: justify;">&nbsp;</p>
<p style="text-align: justify;">&nbsp;</p>
<p style="text-align: justify;">&nbsp;</p>
						</div>
						<div id="ctl00_MainContent_MeetingTypeRepeater_ctl13_MeetingLinks" class="meeting-type-links item-description">
							<ol id="ctl00_MainContent_MeetingTypeRepeater_ctl13_MeetingLinksList" style="margin-top:1em;">
							</ol>
						</div>

					</div>
					<div style="display: inline-block; width: 95%; position: absolute; right: 10px; bottom: 10px;">
						
						
					</div>
					<input type="hidden" name="ctl00$MainContent$MeetingTypeRepeater$ctl13$MeetingTypePortalItemId" id="ctl00_MainContent_MeetingTypeRepeater_ctl13_MeetingTypePortalItemId" value="275753" />
				</div>
			
				<div id="ctl00_MainContent_MeetingTypeRepeater_ctl14_ItemTemplate" class="item-template">
					<div id="ctl00_MainContent_MeetingTypeRepeater_ctl14_MeetingTypeLLabel">
						<div class="item-title meeting-type-title">
							<div class="admin-buttons meeting-type-edit-button">
								
							</div>
							<h2>
								<a href="/Portal/MeetingInformation.aspx?type=18" id="ctl00_MainContent_MeetingTypeRepeater_ctl14_Title" class="meeting-type-item-title" style="color: #fff;">Community Services &amp; Environment Commission</a>
								
							</h2>
						</div>
					</div>
					<div class="meeting-type-item item-content" style="padding-bottom: 0 !important">
						<div class="meeting-type-item-description item-description portal-item-description">
							<p>The Community Services and Environment Commission has been disbanded and no longer meets.&nbsp;</p><p>&nbsp;</p><p><a href="https://sonomacity.civicweb.net/filepro/documents/5427" target="_blank">View Agendas</a></p><p><a href="https://sonomacity.civicweb.net/filepro/documents/5426" target="_blank">View Minutes</a></p>
						</div>
						<div id="ctl00_MainContent_MeetingTypeRepeater_ctl14_MeetingLinks" class="meeting-type-links item-description">
							<ol id="ctl00_MainContent_MeetingTypeRepeater_ctl14_MeetingLinksList" style="margin-top:1em;">
							<li style="position:relative;padding-right:15px;"><span class="list-custom-bullet-document background-color"></span><a class="list-link" href="/Portal/MeetingInformation.aspx?Id=901">Community Services &amp; Environment Commission - 09 Feb 2022</a><em class="video-event glyphicon glyphicon-facetime-video" date-id="901" aria-label="Includes Video" style="position:absolute;right:0px;top:5px;margin:0 0 0 0.4em;text-indent:0em;"></em></li><li style="position:relative;"><span class="list-custom-bullet-document background-color"></span><a class="list-link" href="/Portal/MeetingInformation.aspx?Id=717">Joint Climate Action Subcommittee Dec 8, 2021</a></li><li style="position:relative;padding-right:15px;"><span class="list-custom-bullet-document background-color"></span><a class="list-link" href="/Portal/MeetingInformation.aspx?Id=714">Community Services &amp; Environment Commission - Nov 10, 2021</a><em class="video-event glyphicon glyphicon-facetime-video" date-id="714" aria-label="Includes Video" style="position:absolute;right:0px;top:5px;margin:0 0 0 0.4em;text-indent:0em;"></em></li></ol>
						</div>

