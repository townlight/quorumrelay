	<div id="sign-in" class="layout-full hidden" role="form" data-popup="True">
				<div class="layout-full layout-column sign-in">
					<div class="layout-section layout-golden layout-pane layout-section-fill layout-full sign-in-credentials">
						<div class="sign-in-content center-top">
							<div class="sign-in-logo">
								<img src="/images/iCompass_DIL_logo.svg" style="max-height: 100px;" alt="iCompass - A Diligent Brand" />
							</div>
							<div class="sign-in-organization">
								City of Sonoma
							</div>
							<form id="sign-in-form" class="sign-in-form" action="/user/signin" method="post">
								<div class="sign-in-section">
									<div class="hidden">
										<label for="sign-in-user-name">User name</label>
									</div>
									<input id="sign-in-user-name" name="username" type="text" placeholder="User name" title="User name" autocapitalize="off" />
								</div>
								<div class="sign-in-section">
									<div class="hidden">
										<label for="sign-in-password">Password</label>
									</div>
									<input id="sign-in-password" name="password" type="password" placeholder="Password" title="Password" autocapitalize="off" />
								</div>
								<div class="sign-in-section">
									<button id="sign-in-button" class="button button-full button-important">Sign In</button>
								</div>
								<div class="sign-in-section layout-column">
									<div class="layout-section layout-middle">
										<input id="sign-in-remember-me" type="checkbox" /><label for="sign-in-remember-me">Remember me next time.</label>
									</div>
									<div class="layout-section layout-section-fill layout-right layout-middle">
										<a href="/user/resetpassword">Forgot password?</a>
									</div>
								</div>
								<div class="sign-in-section hidden">
									<div id="sign-in-warning-message" class="notification notification-warning hidden">
										<span class="notification-icon cw-icon-warning"></span>
										<span class="notification-text"></span>
									</div>
								</div>
							</form>
						</div>
					</div></div>
			</div>

