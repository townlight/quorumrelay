							</div>
							<h2>
								<a href="/Portal/MeetingInformation.aspx?type=48" id="ctl00_MainContent_MeetingTypeRepeater_ctl12_Title" class="meeting-type-item-title" style="color: #fff;">Finance Committee</a>
								
							</h2>
						</div>
					</div>
					<div class="meeting-type-item item-content" style="padding-bottom: 0 !important">
						<div class="meeting-type-item-description item-description portal-item-description">
							
						</div>
						<div id="ctl00_MainContent_MeetingTypeRepeater_ctl12_MeetingLinks" class="meeting-type-links item-description">
