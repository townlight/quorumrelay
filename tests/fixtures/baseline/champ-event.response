                "LegislativeItemID": "0",
                "CustomerEventID": 164,
                "ContainerTypeID": 0,
                "ContainerID": 0,
                "JurisdictionUUID": "",
                "Title": "PUBLIC COMMENT",
                "Description": "<p>This is an opportunity for residents to comment briefly on matters included on the agenda and otherwise of interest to the Commission. Public Comment is limited to 30 minutes total and up to 5 minutes per speaker.<\/p>",
                "OrderParentID": 0,
                "OrderOrdinal": 60,
                "DisplayMask": 0,
                "StatusMask": 0,
                "StatusClassID": 0,
                "ExternalID": "",
                "LastModifyDateTimeUTC": "2025-08-15 20:26:23",
