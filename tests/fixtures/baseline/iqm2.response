    <script type="text/javascript">
        
        // configure tracker
        
        $(function () {
            
            
            FixFooterPosition();
            $(window).on('resize', FixFooterPosition);

            var h = $("#Banner").height();
            //  var w = $("body").width();

            var sCoords = "0,0,5000," + h;

            $("#lnkBanner").attr("coords", sCoords);
            var hideTopBanner = Cookies.get('hideTopBanner');
            var appStyles = {display:'block'};
            if (hideTopBanner) {
                appStyles.display = 'none';
            }
            $('#topbarAppBanner').css(appStyles);
            $('.close-topbar-app-banner').bind('click', function () {
                $('#topbarAppBanner').css('display', 'none');
                Cookies.set('hideTopBanner', true);
            });
            $('.link-wrapper-banner').bind('click', function () {
                woopra.track('portal-wegovern-banner', {
                    agency: Cookies.get('AgencyName'),
                    username: Cookies.get('WebUserName')
                });
                return true;
            });
        });

        function FixFooterPosition() {
            //hack for the footer, display at bottom of screen if page is short
            if ($("form").height() < $(window).height() - 100) {
                $("#Footer").css("position", "absolute");
                $("#Footer").css("bottom", "0");
            }
            else {
                $("#Footer").css("position", "");
            }
        }

    </script>
    <style type="text/css" media="screen">
        #topbarAppBanner {
            min-height: 40px;
            z-index: 1000;
        }
        .top-banner-app-inner{
            margin-top: 10px;
            margin-bottom: 10px;
            width: 100%;
            height: 40px;
            border: 1px solid rgba(10,10,10,.5);
            box-shadow: 0px 0px 16px 0px #303030;
            background-color: #456ca7;
        }
        .close-topbar-app-banner {
            position: absolute;
            display: block;
            top: 25px;
            right: 5%;
            font-size: 1em;
            color: #e3e3e3
        }
        .app-link{
            display: block;
            margin: 0 auto;
            width: 40%;
        }
        .wegovern-banner-logo {
            left: 22px;
            position: relative;
            padding-top: 1px;
        }

        @media screen and (max-width: 981px ){
            .inside-banner-link {
                position: relative;
                top: -15px;
                left: 30px;
                color: #e3e3e3;
                white-space: nowrap;
            }
        }
        @media screen and (min-width: 1595px){
            .inside-banner-link {
                position: relative;
                top: -15px;
                left: 30px;
                color: #e3e3e3;
                white-space: nowrap;
            }
        }
        @media screen and (max-width: 1594px){
            .inside-banner-link {
                position: relative;
                top: -30px;
                left: 75px;
                color: #e3e3e3;
                white-space: nowrap;
            }
        }
        @media screen and (min-width:1100px){
            .app-link{
                display: block;
                margin: 0 auto;
                width: 40%;
            }
            .close-topbar-app-banner {
                right: 5%;
            }
        }
        @media screen and (max-width:1099px){
            .app-link {
                display: block;
                margin: 0 auto;
                width: 65%;
            }
            .close-topbar-app-banner {
                right: 5%;
            }
            .inside-banner-link {
                position: relative;
                top: -15px;
                left: 30px;
                color: #e3e3e3;
                white-space: nowrap;
            }
        }
    </style>
    

