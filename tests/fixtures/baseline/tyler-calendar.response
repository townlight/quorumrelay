ime":null,"packetFileSize":0,"packetFileSizeThreshold":314572800,"recurringId":1943,"recurringType":"NoRepeat","startDateTime":"2026-11-17T06:00:00.000Z","startTime":"4:00 PM","thumbnailOfVideo":"","videoId":"","videoName":null,"videoStatus":""},{"actualEndDate":"2026-11-17 00:00:00.0","actualStartDate":"2026-11-17 00:00:00.0","adjourned":false,"agendaItemAttachmentTitles":[],"agendaItemDescriptions":[],"agendaItemTitles":[],"agendaOCRedContent":"","agendaPacketDocumentId":"DOC621S746","agendaPacketDocumentIds":["DOC621S746"],"agendaPacketEnabled":false,"agendaPostedDate":"2026-11-03T17:17:19.000Z","agendaSectionHeaderDescriptions":["<div>Finalize Tree Lighting (November 23rd)</div><div><br></div><div>Arbor Day Poster Contest</div><div><br></div><div>Arbor Day</div><div><br></div><div>Grant Update</div>","<div>Approve October minutes.</div>","<div>The next scheduled meeting will be held on <strong>Tues</strong><strong>day</strong><strong>, January 5, 2027, at 9:00 am MST in the office of Murray City Power, 153 West 4800 South, Murray, Utah. </strong><br><br>Special Accommodations for the hearing or visually impaired will be made upon a request to the office of Murray City Recorder (801-264-2662). We would appreciate notification two working days prior to the meeting. TTY is Relay Utah at #711.<br><br>Committee members may participate in the meeting via telephonic communication. If a Committee member does participate via telephonic communication, the Committee member will be on speakerphone.  The speakerphone will be amplified so that the other Committee members and all other persons present will be able to hear all discussions.<br><br>At least 24 hours prior to the meeting, a copy of the foregoing notice was sent to the City Recorder to post in conspicuous view in the front foyer of the Murray City Center, Murray, Utah. A copy of this notice was also posted on Murray City's internet website www.murray.utah.gov and the state noticing website at http://pmn.utah.gov.</