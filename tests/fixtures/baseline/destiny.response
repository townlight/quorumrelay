</head>

<body class="d-flex flex-column h-100">
	<a class="visually-hidden-focusable p-2 text-center text-bg-primary" href="#content">Skip to main content</a>
	<header class="flex-shrink-0 bg-body-tertiary border-bottom d-print-none">
		<h1 class="me-auto">AgendaQuick&trade;</h1>
	</header>

	<main class="flex-shrink-0">
		
			<h1 id="page-title">View Meetings</h1>
		
		<div id="content">
			
			<div class="d-flex align-items-baseline d-print-none">
				
					<a href="officials/" class="btn btn-sm btn-secondary mb-2 me-3" target="_blank"><i class="fa-solid fa-user-group me-1" aria-hidden="true"></i> View Meeting Officials</a>
				
					<a href="subscribe/default.cfm?mode=mtg" class="btn btn-sm btn-success mb-2"><i class="fa-solid fa-clipboard-check me-1" aria-hidden="true"></i> Subscribe</a>
				
			</div>
		

			<form action="default.cfm" method="get" class="border rounded px-3 pt-3 mb-3">
				<div class="input-group mb-3">
					<label for="mt" class="input-group-text">Meeting Type:</label>
					<select title="Select Meeting Type" name="mt" id="mt" class="form-select">
						<option value="ALL">All Meeting Types</option>
						
							<option value="AIR">Airport Commission</option>
						
							<option value="BPA">Beautification & Public Art Commission</option>
						
							<option value="BAC">Bicycle Advisory Committee</option>
						
							<option value="BOA">Board of Adjustment</option>
						
							<option value="CCCSMWS">City Council Combined Special Meeting/Work Session</option>
						
							<option value="CCMTG">City Council Draft Agenda</option>
						
							<option value="CCES">City Council ES</option>
						
							<option value="CCJWS">City Council Joint Work Session</option>
						
							<option value="CCMTGF">City Council Meeting - FINAL</option>
						
							<option value="CCSCM">City Council Special Meeting (Executive Session)</option>
						
							<option value="CCSWS">City Council Special Work Session</option>
						
							<option value="CCWS">City Council Work Session</option>
						
							<option value="DVA">Commission on Diversity Awareness</option>
						
							<option value="DA">Commission on Inclusion and Adaptive Living</option>
						
							<option value="FHA">Flagstaff Housing Authority</option>
						
							<option value="FB">Floodplain Board</option>
						
							<option value="HPC">Heritage Preservation Commission</option>
						
							<option value="HOUS">Housing Commission</option>
						
							<option value="IND">Indigenous Commission </option>
						
							<option value="CCBUDG">Joint Parks & Recreation/Open Space</option>
						
							<option value="LIB">Library Board</option>
						
							<option value="PQ">Notice of Possible Quorum</option>
						
							<option value="OSC">Open Space Commission</option>
						
							<option value="PR">Parks & Recreation</option>
						
							<option value="PAC">Pedestrian Advisory Committee</option>
						
							<option value="PZ">Planning & Zoning Commission</option>
						
							<option value="PSPRS">Public Safety Personnel Retirement System Board</option>
						
							<option value="SUS">Sustainability Commission</option>
						
							<option value="TOUR">Tourism Commission</option>
						
							<option value="TC">Transportation Commission</option>
						
							<option value="WC">Water Commission</option>
						
					</select>
				</div>
				<div class="d-md-flex align-content-bottom">
					<div class="input-group me-3 mb-3">
						<label for="m" class="input-group-text">Month:</label>
						<select title="Select Month" name="month" id="m" class="form-select">
							
								<option value="1">January</option>
							
								<option value="2">February</option>
							
								<option value="3">March</option>
							
								<option value="4">April</option>
							
								<option value="5">May</option>
							
								<option value="6">June</option>
							
								<option value="7">July</option>
							
								<option value="8">August</option>
							
								<option value="9">September</option>
							
								<option value="10">October</option>
							
								<option value="11" selected>November</option>
							
								<option value="12">December</option>
							
						</select>
						<label for="y" class="input-group-text">Year:</label>
						<select title="Select Year" name="year" id="y" class="form-select">
							
								<option value="2030">2030</option>
							
								<option value="2029">2029</option>
							
								<option value="2028">2028</option>
							
								<option value="2027">2027</option>
							
								<option value="2026" selected>2026</option>
							
								<option value="2025">2025</option>
							
								<option value="2024">2024</option>
							
								<option value="2023">2023</option>
							
								<option value="2022">2022</option>
							
								<option value="2021">2021</option>
							
								<option value="2020">2020</option>
							
								<option value="2019">2019</option>
							
								<option value="2018">2018</option>
							
								<option value="2017">2017</option>
							
								<option value="2016">2016</option>
							
								<option value="2015">2015</option>
							
								<option value="2014">2014</option>
							
								<option value="2013">2013</option>
							
								<option value="2012">2012</option>
							
						</select>
					</div>
					<button type="submit" class="btn btn-primary text-nowrap mb-3"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> View Meetings</button>
				</div>
				<div class="row align-content-center">
					<div class="col-6 col-md-4 mb-3">
						<a href="default.cfm?mt=ALL&amp;month=10&amp;year=2026" class="btn btn-secondary btn-block d-block text-nowrap flex-fill">
							<i class="fa-solid fa-chevron-left me-1" aria-hidden="true"></i>
							Oct 2026 
						</a>
					</div>
					<div class="col-6 col-md-4 mb-3">
						<a href="default.cfm?mt=ALL&amp;month=12&amp;year=2026" class="btn btn-secondary btn-block d-block text-nowrap flex-fill">
							Dec 2026 
							<i class="fa-solid fa-chevron-right ms-1" aria-hidden="true"></i>
						</a>
					</div>
					<div class="col-12 col-md-4 mb-3">
						<a href="search.cfm" class="btn btn-secondary btn-block d-block text-nowrap flex-fill"><i class="fa-solid fa-bolt me-1" aria-hidden="true"></i> Advanced Search</a>
					</div>
				</div>
			</form>
		
