{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civic-data-connectors:schema:2.0.0:source",
  "title": "Civic data connectors source 2.0.0",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "object"
    }
  },
  "required": [
    "provider",
    "url"
  ],
  "additionalProperties": true
}
